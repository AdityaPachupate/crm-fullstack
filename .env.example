# --- Common Environment Variables ---

# --- Database ---
DATABASE_URL="Host=your_db_host; Database=neondb; Username=your_user; Password=your_password; SSL Mode=Require; Channel Binding=Require;"
ConnectionStrings__NeonProductionDb="Host=your_db_host; Database=neondb; Username=your_user; Password=your_password; SSL Mode=Require; Channel Binding=Require;"

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
AUTH_USERNAME=your_admin_username
AUTH_PASSWORD=your_admin_password

# --- Frontend ---
VITE_API_BASE_URL=/

# --- WhatsApp Reminders (CallMeBot) ---
CALLMEBOT_API_KEY=your_apikey_here
WHATSAPP_NUMBERS=+911234567890
